{
  "$schema": "../theme-schema.json",
  "name": "mono-editorial",
  "version": "1.0.0",
  "variant": "light",
  "displayName": "Mono Editorial · 흑백 에디토리얼",
  "author": "lecture-producer",
  "license": "MIT",
  "compatibleVersion": ">=1.0.0",
  "description": "흑백 에디토리얼 라이트 테마. 순흑 + 순백 + 1% 레드 악센트. 학술·대학원·저널리즘·문서 중심 교육 적합.",

  "palette": {
    "black": "#ffffff",
    "ink": "#f7f7f7",
    "gold": "#c8102e",
    "goldSoft": "#9a0a20",
    "cream": "#0a0a0a",
    "text": "#1a1a1a",
    "muted": "#6a6a6a",
    "dim": "#c0c0c0",
    "border": "#d8d8d8"
  },

  "svgPalette": ["#c8102e", "#0a0a0a", "#6a6a6a", "#c0c0c0"],

  "typography": {
    "primary": "'Pretendard Variable', 'Pretendard'",
    "fontFallbackStack": "Georgia, 'Noto Serif KR', -apple-system, BlinkMacSystemFont, 'Times New Roman', serif",
    "mono": "'JetBrains Mono', 'Consolas', monospace",
    "letterSpacing": "-0.015em",
    "cdn": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
  },

  "fontSize": {
    "bulletText": "19px",
    "bulletDetail": "16px",
    "sectionTitleClamp": "clamp(28px, 3.4vw, 48px)",
    "coverTitleClamp": "clamp(40px, 5.5vw, 82px)",
    "outroTitleClamp": "clamp(48px, 6vw, 88px)",
    "minSvgText": 11,
    "maxSvgText": 22
  },

  "layout": {
    "svgViewBox": "0 0 400 260",
    "sectionGrid": "1fr 1.2fr",
    "slidePadding": "50px 80px 30px",
    "topbarHeight": "56px",
    "controlsHeight": "80px",
    "thumbStripHeight": "110px",
    "mediaQueries": { "phone": 600, "tablet": 900, "desktopNarrow": 1100 }
  },

  "animation": {
    "transitionMs": 250,
    "revealMs": 500,
    "tiltCubicBezier": "cubic-bezier(0.22, 1, 0.36, 1)",
    "stagger": "0.08s"
  },

  "accessibility": {
    "colorScheme": "light",
    "forcedColorAdjust": "none",
    "wcagTarget": "AAA",
    "focusOutlineWidth": "3px",
    "focusOutlineColor": "#c8102e"
  },

  "background": {
    "defaultMode": "VORONOI",
    "availableModes": ["FLOW", "WAVES", "VORONOI", "NETWORK", "CONSTELLATION"]
  }
}
