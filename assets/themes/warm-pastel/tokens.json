{
  "$schema": "../theme-schema.json",
  "name": "warm-pastel",
  "version": "1.0.0",
  "variant": "light",
  "displayName": "Warm Pastel · 세이지 + 블러시",
  "author": "lecture-producer",
  "license": "MIT",
  "compatibleVersion": ">=1.0.0",
  "description": "부드러운 파스텔 라이트 테마. 크림 배경 + 세이지 그린 + 블러시 핑크. 라이프스타일·여성 창업자·힐링 콘텐츠·공공기관 40·50대 여성 교육 적합.",

  "palette": {
    "black": "#faf5ed",
    "ink": "#f0e8db",
    "gold": "#d87b8b",
    "goldSoft": "#b85e6e",
    "cream": "#3a4a3d",
    "text": "#505a50",
    "muted": "#9aa89a",
    "dim": "#d8e0d0",
    "border": "#e5dcc9"
  },

  "svgPalette": ["#d87b8b", "#7a9576", "#9aa89a", "#d8e0d0"],

  "typography": {
    "primary": "'Pretendard Variable', 'Pretendard'",
    "fontFallbackStack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif",
    "mono": "'JetBrains Mono', 'Consolas', monospace",
    "letterSpacing": "0.005em",
    "cdn": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
  },

  "fontSize": {
    "bulletText": "19px",
    "bulletDetail": "16px",
    "sectionTitleClamp": "clamp(28px, 3.4vw, 48px)",
    "coverTitleClamp": "clamp(40px, 5.5vw, 82px)",
    "outroTitleClamp": "clamp(48px, 6vw, 88px)",
    "minSvgText": 11,
    "maxSvgText": 22
  },

  "layout": {
    "svgViewBox": "0 0 400 260",
    "sectionGrid": "1fr 1.2fr",
    "slidePadding": "50px 80px 30px",
    "topbarHeight": "56px",
    "controlsHeight": "80px",
    "thumbStripHeight": "110px",
    "mediaQueries": { "phone": 600, "tablet": 900, "desktopNarrow": 1100 }
  },

  "animation": {
    "transitionMs": 400,
    "revealMs": 800,
    "tiltCubicBezier": "cubic-bezier(0.22, 1, 0.36, 1)",
    "stagger": "0.14s"
  },

  "accessibility": {
    "colorScheme": "light",
    "forcedColorAdjust": "none",
    "wcagTarget": "AA",
    "focusOutlineWidth": "2px",
    "focusOutlineColor": "#d87b8b"
  },

  "background": {
    "defaultMode": "CONSTELLATION",
    "availableModes": ["FLOW", "WAVES", "VORONOI", "NETWORK", "CONSTELLATION"]
  }
}
