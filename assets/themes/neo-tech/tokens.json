{
  "$schema": "../theme-schema.json",
  "name": "neo-tech",
  "version": "1.0.0",
  "variant": "dark",
  "displayName": "Neo-Tech · 사이버 네온 블루",
  "author": "lecture-producer",
  "license": "MIT",
  "compatibleVersion": ">=1.0.0",
  "description": "개발자·테크 타겟 다크 테마. 딥 네이비 배경 + 시안 네온 악센트 + 라임 그린 보조. 유튜브 개발 채널·해커톤·DevOps·AI 코딩 강의 적합.",

  "palette": {
    "black": "#0a0e27",
    "ink": "#111630",
    "gold": "#00d4ff",
    "goldSoft": "#0099cc",
    "cream": "#e6f4ff",
    "text": "#c9d9e8",
    "muted": "#6a8ab0",
    "dim": "#2a3550",
    "border": "#1a2240"
  },

  "svgPalette": ["#00d4ff", "#e6f4ff", "#6a8ab0", "#2a3550"],

  "typography": {
    "primary": "'Pretendard Variable', 'Pretendard'",
    "fontFallbackStack": "'JetBrains Mono', 'Fira Code', -apple-system, BlinkMacSystemFont, sans-serif",
    "mono": "'JetBrains Mono', 'Fira Code', monospace",
    "letterSpacing": "-0.01em",
    "cdn": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
  },

  "fontSize": {
    "bulletText": "19px",
    "bulletDetail": "16px",
    "sectionTitleClamp": "clamp(28px, 3.4vw, 48px)",
    "coverTitleClamp": "clamp(40px, 5.5vw, 82px)",
    "outroTitleClamp": "clamp(48px, 6vw, 88px)",
    "minSvgText": 11,
    "maxSvgText": 22
  },

  "layout": {
    "svgViewBox": "0 0 400 260",
    "sectionGrid": "1fr 1.2fr",
    "slidePadding": "50px 80px 30px",
    "topbarHeight": "56px",
    "controlsHeight": "80px",
    "thumbStripHeight": "110px",
    "mediaQueries": { "phone": 600, "tablet": 900, "desktopNarrow": 1100 }
  },

  "animation": {
    "transitionMs": 350,
    "revealMs": 700,
    "tiltCubicBezier": "cubic-bezier(0.22, 1, 0.36, 1)",
    "stagger": "0.12s"
  },

  "accessibility": {
    "colorScheme": "dark",
    "forcedColorAdjust": "none",
    "wcagTarget": "AA",
    "focusOutlineWidth": "2px",
    "focusOutlineColor": "#00d4ff"
  },

  "background": {
    "defaultMode": "NETWORK",
    "availableModes": ["FLOW", "WAVES", "VORONOI", "NETWORK", "CONSTELLATION"]
  }
}
