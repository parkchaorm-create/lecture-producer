{
  "$schema": "../theme-schema.json",
  "name": "paperback",
  "version": "1.0.0",
  "variant": "light",
  "displayName": "Paperback · 라이트 크림 서적풍",
  "author": "lecture-producer",
  "license": "MIT",
  "compatibleVersion": ">=1.0.0",
  "description": "종이책 질감의 라이트 테마. 오프화이트 배경 + 잉크 블랙 + 와인색 악센트. 온라인 강의·독서 모임·인문학 교육 적합.",

  "palette": {
    "black": "#f5efdd",
    "ink": "#e8dfc5",
    "gold": "#8e2b3b",
    "goldSoft": "#6a1e2b",
    "cream": "#2a1a15",
    "text": "#3a2620",
    "muted": "#8a7566",
    "dim": "#c9b896",
    "border": "#d4c4a5"
  },

  "svgPalette": ["#8e2b3b", "#2a1a15", "#8a7566", "#c9b896"],

  "typography": {
    "primary": "'Pretendard Variable', 'Pretendard'",
    "fontFallbackStack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Apple SD Gothic Neo', 'Malgun Gothic', serif",
    "mono": "'JetBrains Mono', 'Consolas', monospace",
    "letterSpacing": "-0.005em",
    "cdn": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
  },

  "fontSize": {
    "bulletText": "19px",
    "bulletDetail": "16px",
    "sectionTitleClamp": "clamp(28px, 3.4vw, 48px)",
    "coverTitleClamp": "clamp(40px, 5.5vw, 82px)",
    "outroTitleClamp": "clamp(48px, 6vw, 88px)",
    "minSvgText": 11,
    "maxSvgText": 22
  },

  "layout": {
    "svgViewBox": "0 0 400 260",
    "sectionGrid": "1fr 1.2fr",
    "slidePadding": "50px 80px 30px",
    "topbarHeight": "56px",
    "controlsHeight": "80px",
    "thumbStripHeight": "110px",
    "mediaQueries": { "phone": 600, "tablet": 900, "desktopNarrow": 1100 }
  },

  "animation": {
    "transitionMs": 350,
    "revealMs": 700,
    "tiltCubicBezier": "cubic-bezier(0.22, 1, 0.36, 1)",
    "stagger": "0.12s"
  },

  "accessibility": {
    "colorScheme": "light",
    "forcedColorAdjust": "none",
    "wcagTarget": "AA",
    "focusOutlineWidth": "2px",
    "focusOutlineColor": "#8e2b3b"
  },

  "background": {
    "defaultMode": "WAVES",
    "availableModes": ["FLOW", "WAVES", "VORONOI", "NETWORK", "CONSTELLATION"]
  }
}
