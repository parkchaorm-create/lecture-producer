{
  "$schema": "../../assets/themes/theme-schema.json",
  "brand": "my-brand",
  "extends": "pajamaboss",
  "description": "브랜드 악센트·로고 폰트만 override. 핵심 팔레트는 extends된 테마 그대로.",

  "overrides": {
    "palette": {
      "accent": null
    },
    "typography": {
      "logoFont": null
    }
  },

  "logo": {
    "aspectRatio": "auto",
    "minSize": 120,
    "maxSize": 280,
    "coverPosition": "top-left"
  },

  "watermark": {
    "position": "bottom-right",
    "opacity": 0.4,
    "scale": 0.8
  }
}
